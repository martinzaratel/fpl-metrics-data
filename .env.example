# Copy this file to .env and fill in the real values. .env is gitignored --
# never commit it.

# GitHub personal access token with "Contents: Read and write" permission
# on martinzaratel/fpl-metrics-data (fine-grained token scoped to just this
# repo is recommended). Used by scripts/publish_to_github.py to push
# metrics.json via the Contents API.
GITHUB_TOKEN=

# Optional overrides -- defaults match the live pipeline, only change these
# for testing against a fork/different branch.
# GITHUB_REPO=martinzaratel/fpl-metrics-data
# GITHUB_BRANCH=main
# GITHUB_METRICS_PATH=metrics.json
